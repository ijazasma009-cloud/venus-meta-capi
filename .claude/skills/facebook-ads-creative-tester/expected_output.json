  "test_overview": {
    "objective": "Determine whether pain point hooks outperform question hooks for driving engagement and conversions",
    "hypothesis": "If we use a pain point hook that quantifies the cost of the problem, then 3-second hook rate will increase by 20% because specific pain points create stronger emotional resonance than generic questions",
    "variable_tested": "Video hook style (first 3 seconds)",
    "test_type": "A/B Test"
  },
  "test_variants": {
    "variant_a": {
      "name": "Control - Question Hook",
      "description": "Opens with 'Tired of [problem]?'",
      "key_element": "Question-based hook prompting self-reflection"
    },
    "variant_b": {
      "name": "Challenger - Pain Point Hook",
      "description": "Opens with '[Problem] is costing you $X every day'",
      "key_element": "Quantified pain point with specific cost"
    },
    "isolation_confirmed": true,
    "isolation_note": "Only the first 3 seconds differ; remainder of video is identical"
  },
